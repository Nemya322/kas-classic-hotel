---
import Layout from "../layouts/Layout.astro";
import { hotelInfo, menuCategories } from "../data/hotelData";

const location = `${hotelInfo.city}, ${hotelInfo.region}, ${hotelInfo.country}`;
const whatsappUrl = (message: string) =>
  `https://wa.me/${hotelInfo.whatsappNumber}?text=${encodeURIComponent(message)}`;
const menuOrderUrl = (itemName: string, price: string) =>
  whatsappUrl(`Hello Kas Classic Hotel, I would like to order ${itemName} (TZS ${price}). Please confirm availability.`);
const roomPhotos = [
  {
    src: "/images/hotel/stay-bedroom-storage.webp",
    alt: "Bright bedroom with a bed, television, storage and bathroom entrance at Kas Classic Hotel",
    en: "A bright bedroom with a bed, television, storage and bathroom entrance.",
    sw: "Chumba chenye mwanga, kitanda, televisheni, kabati na mlango wa bafu.",
  },
  {
    src: "/images/hotel/stay-bedroom-headboard.webp",
    alt: "Bedroom with a large bed, upholstered headboard and seating at Kas Classic Hotel",
    en: "A bedroom with a large bed, upholstered headboard and seating.",
    sw: "Chumba chenye kitanda kikubwa, ubao wa kitanda uliopambwa na viti.",
  },
  {
    src: "/images/hotel/stay-bedroom-tv.webp",
    alt: "A second view of a bedroom with a bed and television at Kas Classic Hotel",
    en: "Another view of a bedroom with a bed, television and bathroom entrance.",
    sw: "Mwonekano mwingine wa chumba chenye kitanda, televisheni na mlango wa bafu.",
  },
  {
    src: "/images/hotel/stay-bedroom-dressing.webp",
    alt: "Bedroom with a bed, television, dressing table and sitting area at Kas Classic Hotel",
    en: "A bedroom with a bed, television, dressing table and sitting area.",
    sw: "Chumba chenye kitanda, televisheni, meza ya kujipamba na sehemu ya kukaa.",
  },
  {
    src: "/images/hotel/stay-twin-beds.webp",
    alt: "Room with two beds and bedside lighting at Kas Classic Hotel",
    en: "A room arranged with two beds and bedside lighting.",
    sw: "Chumba chenye vitanda viwili na taa za pembeni ya kitanda.",
  },
];
const poolPhotos = [
  {
    src: "/images/hotel/pool-01.jpg",
    enTitle: "Poolside seating",
    swTitle: "Sehemu ya kukaa kando ya bwawa",
    enDetail: "A view across the outdoor pool, lounge chairs and shaded seating.",
    swDetail: "Mwonekano wa bwawa la nje, viti vya kupumzikia na sehemu yenye kivuli.",
  },
  {
    src: "/images/hotel/pool-02.jpg",
    enTitle: "The pool from above",
    swTitle: "Bwawa kwa mwonekano wa juu",
    enDetail: "An overhead view of the pool and its surrounding seating area.",
    swDetail: "Mwonekano wa juu wa bwawa na sehemu za kukaa zinazolizunguka.",
  },
  {
    src: "/images/hotel/pool-05.jpg",
    enTitle: "Swimming pool",
    swTitle: "Bwawa la kuogelea",
    enDetail: "A closer look at the pool water and surrounding lounge area.",
    swDetail: "Mwonekano wa karibu wa maji ya bwawa na sehemu ya kupumzikia.",
  },
];
const hotelHighlights = [
  {
    src: "/images/hotel/outside-01.jpg",
    enTitle: "The Kas Classic landmark",
    swTitle: "Jengo maarufu la Kas Classic",
    enDetail: "A wide exterior view of the hotel, with gym and honeymoon room signs visible.",
    swDetail: "Mwonekano mpana wa hoteli, huku alama za gym na chumba cha fungate zikionekana.",
    message: "Please share directions and current information about the hotel and its on-site services.",
  },
  {
    src: "/images/hotel/outside-05.jpg",
    enTitle: "Restaurant entrance",
    swTitle: "Mlango wa mgahawa",
    enDetail: "The exterior photo shows the restaurant entrance at the hotel.",
    swDetail: "Picha ya nje inaonyesha mlango wa mgahawa wa hoteli.",
    message: "Please share the restaurant menu and current opening hours.",
  },
  {
    src: "/images/hotel/outside-06.jpg",
    enTitle: "Services listed at the hotel",
    swTitle: "Huduma zilizoandikwa kwenye bango",
    enDetail: "The roadside sign lists accommodation, pool, restaurants, gym, mini shop and mini bank. Ask which are currently available.",
    swDetail: "Bango la barabarani linaorodhesha malazi, bwawa, migahawa, gym, duka na mini bank. Uliza huduma zinazopatikana sasa.",
    message: "Please confirm which facilities and services shown on the hotel sign are currently available.",
  },
];
const contactUrl = whatsappUrl("Hello Kas Classic Hotel, I would like to get in touch.");
---

<Layout>
  <a class="skip-link" href="#main">
    <span data-i18n="en">Skip to content</span>
    <span data-i18n="sw">Ruka hadi maudhui</span>
  </a>

  <div class="topbar">
    <div class="shell topbar-inner">
      <p class="topbar-location">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        {location}
      </p>
      <a class="topbar-link" href={hotelInfo.instagram.profileUrl} target="_blank" rel="noopener noreferrer">
        <span data-i18n="en">Follow us on Instagram</span>
        <span data-i18n="sw">Tufuate Instagram</span>
        <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
      </a>
    </div>
  </div>

  <header class="site-header">
    <div class="shell header-inner">
      <a href="#home" class="brand" aria-label="Kas Classic Hotel home">
        <img class="brand-logo" src="/images/hotel/hotel-logo.png" alt="Kas Classic Hotel" />
        <span class="brand-copy">
          <span class="brand-subtitle">HOTEL · MAKAMBAKO</span>
        </span>
      </a>

      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation">
        <span></span><span></span>
      </button>

      <nav class="main-nav" id="primary-navigation" aria-label="Main navigation">
        <a href="#stay"><span data-i18n="en">Accommodation</span><span data-i18n="sw">Malazi</span></a>
        <a href="#discover"><span data-i18n="en">Facilities</span><span data-i18n="sw">Huduma</span></a>
        <a href="#menu"><span data-i18n="en">Menu</span><span data-i18n="sw">Menyu</span></a>
        <a href="#visit"><span data-i18n="en">Find us</span><span data-i18n="sw">Mahali</span></a>
        <a href={hotelInfo.instagram.profileUrl} target="_blank" rel="noopener noreferrer">Instagram <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
      </nav>

      <div class="header-actions">
        <div class="language-switch" role="group" aria-label="Language">
          <button type="button" data-set-lang="en" aria-pressed="true">EN</button>
          <button type="button" data-set-lang="sw" aria-pressed="false">SW</button>
        </div>
        <a class="button button-small button-red" href={contactUrl} target="_blank" rel="noopener noreferrer">
          <span data-i18n="en">Get in touch</span>
          <span data-i18n="sw">Wasiliana</span>
          <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
        </a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="home" aria-labelledby="hero-title">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow eyebrow-light"><span class="eyebrow-dot"></span>
            <span data-i18n="en">Kas Classic Hotel · Makambako</span>
            <span data-i18n="sw">Karibu Makambako</span>
          </p>
          <h1 id="hero-title">
            <span data-i18n="en">Stay, swim<br />and <em>unwind.</em></span>
            <span data-i18n="sw">Lala, oga<br />na <em>pumzika.</em></span>
          </h1>
          <p class="hero-description">
            <span data-i18n="en">Explore hotel accommodation, the outdoor pool, restaurant and more at Kas Classic Hotel.</span>
            <span data-i18n="sw">Gundua malazi, bwawa la nje, mgahawa na huduma nyingine katika Kas Classic Hotel.</span>
          </p>
          <div class="hero-actions">
            <a class="button button-orange" href={whatsappUrl("Hello Kas Classic Hotel, please share room rates and availability for my dates.")} target="_blank" rel="noopener noreferrer">
              <span data-i18n="en">Ask about a stay</span>
              <span data-i18n="sw">Uliza kuhusu malazi</span>
              <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </a>
            <a class="button button-ghost" href="#stay">
              <span data-i18n="en">View accommodation</span>
              <span data-i18n="sw">Tazama malazi</span>
              <svg class="icon-down" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14m-7-7 7 7 7-7" /></svg>
            </a>
          </div>
          <div class="hero-note">
            <span class="hero-note-rule"></span>
            <span data-i18n="en">Makambako Town · Njombe, Tanzania</span>
            <span data-i18n="sw">Makambako · Njombe, Tanzania</span>
          </div>
        </div>

        <div class="hero-art">
          <img
            src="/images/hotel/outside-01.jpg"
            alt="Kas Classic Hotel exterior in Makambako, with the hotel and adjoining shops visible"
            fetchpriority="high"
          />
          <div class="hero-photo-caption">
            <span data-i18n="en">THE KAS CLASSIC EXPERIENCE</span>
            <span data-i18n="sw">KARIBU KAS CLASSIC</span>
            <b>MAKAMBAKO · TANZANIA</b>
          </div>
        </div>
      </div>
      <a class="scroll-cue" href="#story" aria-label="Scroll to hotel overview"><span></span></a>
    </section>

    <section class="intro-section section-pad" id="story">
      <div class="shell intro-grid">
        <div class="intro-heading">
          <p class="eyebrow"><span class="eyebrow-dot"></span>
            <span data-i18n="en">More than a place to sleep</span>
            <span data-i18n="sw">Zaidi ya sehemu ya kulala</span>
          </p>
          <h2>
            <span data-i18n="en">Make your stay<br />in <em>Makambako.</em></span>
            <span data-i18n="sw">Furahia ukaaji<br /><em>Makambako.</em></span>
          </h2>
        </div>
        <div class="intro-copy">
          <p>
            <span data-i18n="en">See the rooms, outdoor pool and hotel surroundings in the photos below. Contact the hotel to confirm current rates, access and availability.</span>
            <span data-i18n="sw">Tazama vyumba, bwawa la nje na mazingira ya hoteli kwenye picha hapa chini. Wasiliana na hoteli kuthibitisha bei, huduma na upatikanaji.</span>
          </p>
          <a class="text-link" href="#discover">
            <span data-i18n="en">Explore the facilities</span>
            <span data-i18n="sw">Gundua huduma</span>
            <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="stay-section section-pad" id="stay">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span class="eyebrow-dot"></span>
              <span data-i18n="en">Accommodation</span>
              <span data-i18n="sw">Malazi</span>
            </p>
            <h2>
              <span data-i18n="en">Find your room<br /><em>at Kas Classic.</em></span>
              <span data-i18n="sw">Chagua chumba<br /><em>Kas Classic.</em></span>
            </h2>
          </div>
          <div class="section-heading-action">
            <p class="section-heading-note">
              <span data-i18n="en">Real room photos from the hotel's Instagram. Ask the hotel about rates and availability for your dates.</span>
              <span data-i18n="sw">Picha halisi za vyumba kutoka Instagram ya hoteli. Uliza hoteli kuhusu bei na upatikanaji wa tarehe zako.</span>
            </p>
            <a class="button button-red" href={whatsappUrl("Hello Kas Classic Hotel, please share your room rates and availability for my dates.")} target="_blank" rel="noopener noreferrer">
              <span data-i18n="en">Ask about a stay</span>
              <span data-i18n="sw">Uliza kuhusu malazi</span>
              <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </a>
            <a class="text-link room-source-link" href={hotelInfo.instagram.post.url} target="_blank" rel="noopener noreferrer">
              <span data-i18n="en">See all five photos in the original Instagram post</span>
              <span data-i18n="sw">Tazama picha zote tano kwenye chapisho la Instagram</span>
              <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </a>
          </div>
        </div>

        <div class="experience-grid room-grid">
          {roomPhotos.map((photo) => (
            <a
              class="experience-card"
              href={whatsappUrl("Hello Kas Classic Hotel, please share your room options, rates and availability for my dates.")}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="experience-card-image">
                <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
                <span class="experience-card-arrow" aria-hidden="true"><svg class="icon-arrow" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10" /></svg></span>
              </div>
              <div class="experience-card-copy">
                <p>
                  <span data-i18n="en">{photo.en}</span>
                  <span data-i18n="sw">{photo.sw}</span>
                </p>
                <span class="experience-card-action">
                  <span data-i18n="en">Ask about rates &amp; availability</span>
                  <span data-i18n="sw">Uliza kuhusu bei na upatikanaji</span>
                  <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="discover-section section-pad" id="discover">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span class="eyebrow-dot"></span>
              <span data-i18n="en">More to enjoy</span>
              <span data-i18n="sw">Zaidi ya kufurahia</span>
            </p>
            <h2>
              <span data-i18n="en">Explore the hotel<br /><em>and its surroundings.</em></span>
              <span data-i18n="sw">Gundua hoteli<br /><em>na mazingira yake.</em></span>
            </h2>
          </div>
          <p class="section-heading-note">
            <span data-i18n="en">Each photo opens a WhatsApp enquiry about what you see. Confirm opening hours, access and availability with the hotel.</span>
            <span data-i18n="sw">Kila picha inafungua ujumbe wa WhatsApp kuhusu unachokiona. Thibitisha saa za kazi, matumizi na upatikanaji kwa hoteli.</span>
          </p>
        </div>

        <h3 class="experience-group-title">
          <span data-i18n="en">Pool & outdoor space</span>
          <span data-i18n="sw">Bwawa na sehemu za nje</span>
        </h3>
        <div class="experience-grid">
          {poolPhotos.map((photo) => (
            <a
              class="experience-card"
              href={whatsappUrl(`Hello Kas Classic Hotel, please confirm pool access, opening times and any fees. I am asking about: ${photo.enTitle}.`)}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="experience-card-image">
                <img src={photo.src} alt={`${photo.enTitle} at Kas Classic Hotel`} loading="lazy" decoding="async" />
                <span class="experience-card-arrow" aria-hidden="true"><svg class="icon-arrow" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10" /></svg></span>
              </div>
              <div class="experience-card-copy">
                <h3>
                  <span data-i18n="en">{photo.enTitle}</span>
                  <span data-i18n="sw">{photo.swTitle}</span>
                </h3>
                <p>
                  <span data-i18n="en">{photo.enDetail}</span>
                  <span data-i18n="sw">{photo.swDetail}</span>
                </p>
                <span class="experience-card-action">
                  <span data-i18n="en">Ask about pool access</span>
                  <span data-i18n="sw">Uliza kuhusu matumizi ya bwawa</span>
                  <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                </span>
              </div>
            </a>
          ))}
        </div>

        <h3 class="experience-group-title">
          <span data-i18n="en">Around Kas Classic</span>
          <span data-i18n="sw">Karibu na Kas Classic</span>
        </h3>
        <div class="experience-grid">
          {hotelHighlights.map((photo) => (
            <a
              class="experience-card"
              href={whatsappUrl(`Hello Kas Classic Hotel, ${photo.message}`)}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="experience-card-image">
                <img src={photo.src} alt={photo.enTitle} loading="lazy" decoding="async" />
                <span class="experience-card-arrow" aria-hidden="true"><svg class="icon-arrow" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10" /></svg></span>
              </div>
              <div class="experience-card-copy">
                <h3>
                  <span data-i18n="en">{photo.enTitle}</span>
                  <span data-i18n="sw">{photo.swTitle}</span>
                </h3>
                <p>
                  <span data-i18n="en">{photo.enDetail}</span>
                  <span data-i18n="sw">{photo.swDetail}</span>
                </p>
                <span class="experience-card-action">
                  <span data-i18n="en">Ask for details</span>
                  <span data-i18n="sw">Uliza maelezo</span>
                  <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="menu-section section-pad" id="menu">
      <div class="shell">
        <div class="section-heading menu-heading">
          <div>
            <p class="eyebrow"><span class="eyebrow-dot"></span>
              <span data-i18n="en">From the kitchen</span>
              <span data-i18n="sw">Kutoka jikoni</span>
            </p>
            <h2>
              <span data-i18n="en">See something you <em>like?</em></span>
              <span data-i18n="sw">Umeona unachokipenda?</span>
            </h2>
          </div>
          <p class="menu-intro">
            <span data-i18n="en">Browse the dishes, see their prices and order directly on WhatsApp.</span>
            <span data-i18n="sw">Tazama vyakula na bei, kisha agiza moja kwa moja kupitia WhatsApp.</span>
          </p>
        </div>

        <p class="menu-category-nav-title">
          <span data-i18n="en">Jump to a menu category</span>
          <span data-i18n="sw">Chagua aina ya menyu</span>
        </p>
        <nav class="menu-category-nav" aria-label="Menu categories">
          {menuCategories.map((category) => (
            <a href={`#menu-${category.id}`}>
              <span>
                <span data-i18n="en">{category.name}</span>
                <span data-i18n="sw">{category.swName}</span>
              </span>
              <span class="menu-category-nav-count">
                {category.items.length}
                <span data-i18n="en">{category.items.length === 1 ? " item" : " items"}</span>
                <span data-i18n="sw">{category.items.length === 1 ? " kipengele" : " vipengele"}</span>
              </span>
            </a>
          ))}
        </nav>

        <div class="menu-category-grid">
          {menuCategories.map((category, index) => (
            <section class="menu-category" id={`menu-${category.id}`} aria-labelledby={`menu-title-${category.id}`}>
              <header class="menu-category-heading">
                <span class="menu-category-number">{String(index + 1).padStart(2, "0")}</span>
                <h3 id={`menu-title-${category.id}`}>
                  <span data-i18n="en">{category.name}</span>
                  <span data-i18n="sw">{category.swName}</span>
                </h3>
                <span class="menu-category-count">
                  {category.items.length}
                  <span data-i18n="en"> items</span>
                  <span data-i18n="sw"> vyakula</span>
                </span>
              </header>
              {category.note && (
                <p class="menu-category-note">
                  <span data-i18n="en">{category.note}</span>
                  <span data-i18n="sw">{"swNote" in category ? category.swNote : category.note}</span>
                </p>
              )}
              <ul class="menu-item-list">
                {category.items.map((item) => (
                  <li class="menu-item">
                    <img
                      class="menu-item-photo"
                      src={item.image}
                      alt={`${item.name} as pictured on the hotel menu`}
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="menu-item-details">
                      <h4>{item.name}</h4>
                      {"description" in item && item.description && <p>{item.description}</p>}
                    </div>
                    <div class="menu-item-action">
                      <span class="menu-item-price">TZS {item.price}</span>
                      <a
                        class="menu-order-link"
                        href={menuOrderUrl(item.name, item.price)}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Order ${item.name} for TZS ${item.price} on WhatsApp`}
                      >
                        <span data-i18n="en">Order</span>
                        <span data-i18n="sw">Agiza</span>
                        <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                      </a>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <p class="menu-footnote">
          <span data-i18n="en">Prices are shown as listed on the supplied menu. Please confirm current availability and which serving sizes the Chips Masala prices apply to.</span>
          <span data-i18n="sw">Bei zimeonyeshwa kama zilivyo kwenye menyu iliyotolewa. Thibitisha upatikanaji na ukubwa unaolingana na bei za Chips Masala.</span>
        </p>
      </div>
    </section>

    <section class="visit-section section-pad" id="visit">
      <div class="shell visit-grid">
        <div class="visit-copy">
          <p class="eyebrow"><span class="eyebrow-dot"></span>
            <span data-i18n="en">Come say hello</span>
            <span data-i18n="sw">Karibu ututembelee</span>
          </p>
          <h2>
            <span data-i18n="en">Your Makambako<br /><em>meeting point.</em></span>
            <span data-i18n="sw">Sehemu yako<br /><em>Makambako.</em></span>
          </h2>
          <p>
            <span data-i18n="en">Find Kas Classic Hotel in Makambako Town, Njombe Region. Open the map to plan your route, then check Instagram for the latest hotel updates.</span>
            <span data-i18n="sw">Ipate Kas Classic Hotel Makambako, Mkoa wa Njombe. Fungua ramani kupanga njia, kisha angalia Instagram kwa taarifa mpya za hoteli.</span>
          </p>
          <div class="visit-actions">
            <a class="button button-blue" href="https://www.google.com/maps/search/?api=1&query=Kas+Classic+Hotel+Makambako+Tanzania" target="_blank" rel="noopener noreferrer">
              <span data-i18n="en">Open map</span><span data-i18n="sw">Fungua ramani</span><svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </a>
            <a class="button button-outline" href={hotelInfo.instagram.profileUrl} target="_blank" rel="noopener noreferrer">
