              <a href={hotelInfo.instagram.profileUrl} target="_blank" rel="noopener noreferrer">@{hotelInfo.instagram.handle}</a>
            </div>
          </div>

          <div class="visit-actions">
            <a class="button button-blue" href="https://www.google.com/maps/search/?api=1&query=Kas+Classic+Hotel+Makambako+Tanzania" target="_blank" rel="noopener noreferrer">
              <span data-i18n="en">Open in Google Maps</span><span data-i18n="sw">Fungua Google Maps</span><svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </a>
            <a
              class="button button-outline"
              href={contactEn}
              data-wa-en={contactEn}
              data-wa-sw={contactSw}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span data-i18n="en">Chat on WhatsApp</span><span data-i18n="sw">Chati WhatsApp</span><svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </a>
          </div>
        </div>

        <div class="location-card">
          <div class="location-card-top">
            <div class="location-card-badge">
              <span class="location-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
              </span>
              <span class="location-label">FIND US · MAKAMBAKO</span>
            </div>
            <span class="location-region-tag">NJOMBE REGION · TZ</span>
          </div>
          <p class="location-town">Kas Classic Hotel<span>.</span></p>

          <div class="location-showcase">
            <figure class="location-signpost">
              <img src="/images/hotel/outside-06.jpg" alt="Kas Classic Hotel roadside signpost and parking courtyard in Makambako" loading="lazy" decoding="async" />
              <figcaption>
                <span data-i18n="en">Roadside Signpost &amp; Parking</span>
                <span data-i18n="sw">Bango la Barabarani &amp; Maegesho</span>
              </figcaption>
            </figure>
            <div class="location-map-embed">
              <iframe
                title="Kas Classic Hotel Makambako Map"
                src="https://www.google.com/maps?q=Makambako,+Njombe,+Tanzania&output=embed"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>

          <p class="map-note">
            <span data-i18n="en">Conveniently located in Makambako Town for highway travelers, families, and business guests across the Njombe corridor.</span>
            <span data-i18n="sw">Ipo katika mji wa Makambako— mahali rafiki kwa wasafiri wa barabara kuu, familia na wafanyabiashara.</span>
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-main">
      <a href="#home" class="brand footer-brand" aria-label="Kas Classic Hotel home">
        <img class="brand-logo" src="/images/hotel/hotel-logo.png" alt="Kas Classic Hotel" />
        <span class="brand-copy"><span class="brand-subtitle">HOTEL · MAKAMBAKO</span></span>
      </a>
      <p>{location} · {hotelInfo.phoneDisplay} / {hotelInfo.secondaryPhone}</p>
      <a href={hotelInfo.instagram.profileUrl} target="_blank" rel="noopener noreferrer" aria-label={`Instagram @${hotelInfo.instagram.handle}`}>
        <svg class="instagram-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.7" cy="6.8" r=".8" fill="currentColor" stroke="none" /></svg>
        <span>@{hotelInfo.instagram.handle}</span>
      </a>
    </div>
    <div class="shell footer-bottom">
      <span>© {new Date().getFullYear()} {hotelInfo.name}</span>
      <a href="#home" class="back-top-link">
        <span data-i18n="en">Back to top</span><span data-i18n="sw">Rudi juu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
      </a>
    </div>
  </footer>

  <script is:inline define:vars={{ whatsappNumber: hotelInfo.whatsappNumber }}>
    (() => {
      const html = document.documentElement;
      const languageButtons = document.querySelectorAll("[data-set-lang]");
      const menuToggle = document.querySelector(".menu-toggle");
      const nav = document.querySelector("#primary-navigation");

      function setLanguage(language) {
        const normalized = language === "sw" ? "sw" : "en";
        html.setAttribute("lang", normalized);
        html.setAttribute("data-lang", normalized);
        try {
          localStorage.setItem("kas_lang", normalized);
        } catch (e) {}

        const isSwahili = normalized === "sw";
        languageButtons.forEach((button) => {
          const selected = button.getAttribute("data-set-lang") === normalized;
          button.setAttribute("aria-pressed", String(selected));
        });

        document.querySelectorAll("[data-wa-en][data-wa-sw]").forEach((link) => {
          const targetHref = link.getAttribute(isSwahili ? "data-wa-sw" : "data-wa-en");
          if (targetHref) link.setAttribute("href", targetHref);
        });

        if (menuToggle) {
          const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
          menuToggle.setAttribute("aria-label", isSwahili
            ? (isOpen ? "Funga menyu" : "Fungua menyu")
            : (isOpen ? "Close navigation" : "Open navigation"));
        }
        document.querySelectorAll("[data-hotel-carousel] [data-label-en], [data-room-carousel] [data-label-en]").forEach((element) => {
          const label = element.getAttribute(isSwahili ? "data-label-sw" : "data-label-en");
          if (label) element.setAttribute("aria-label", label);
        });
        const eventTablist = document.querySelector(".event-tabs");
        if (eventTablist) {
          eventTablist.setAttribute("aria-label", isSwahili ? "Matukio na vifurushi" : "Events and packages");
        }
        document.querySelectorAll("option[data-label-en][data-label-sw]").forEach((opt) => {
          const text = opt.getAttribute(isSwahili ? "data-label-sw" : "data-label-en");
          if (text) opt.textContent = text;
        });
      }

      languageButtons.forEach((button) => {
        button.addEventListener("click", () => {
          setLanguage(button.getAttribute("data-set-lang") === "sw" ? "sw" : "en");
        });
      });

      function closeMenu() {
        if (!menuToggle || !nav) return;
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", html.lang === "sw" ? "Fungua menyu" : "Open navigation");
        nav.classList.remove("is-open");
      }

      menuToggle?.addEventListener("click", (event) => {
        event.stopPropagation();
        const isOpen = menuToggle.getAttribute("aria-expanded") !== "true";
        menuToggle.setAttribute("aria-expanded", String(isOpen));
        menuToggle.setAttribute("aria-label", html.lang === "sw"
          ? (isOpen ? "Funga menyu" : "Fungua menyu")
          : (isOpen ? "Close navigation" : "Open navigation"));
        nav?.classList.toggle("is-open", isOpen);
      });

      nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
      document.addEventListener("click", (event) => {
        if (nav?.classList.contains("is-open") && !nav.contains(event.target) && !menuToggle?.contains(event.target)) {
          closeMenu();
        }
      });
      window.addEventListener("resize", () => {
        if (window.innerWidth > 960) closeMenu();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenu();
      });

      // Initialize Quick Availability Booking Bar Dates & Submission
      const checkInInput = document.getElementById("bookCheckIn");
      const checkOutInput = document.getElementById("bookCheckOut");
      const roomSelect = document.getElementById("bookRoomType");
      const guestsSelect = document.getElementById("bookGuests");
      if (checkInInput && checkOutInput) {
        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(today.getDate() + 1);
        checkInInput.value = today.toISOString().split("T")[0];
        checkOutInput.value = tomorrow.toISOString().split("T")[0];
      }

      document.querySelectorAll("[data-pick-room]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const picked = btn.getAttribute("data-pick-room");
          if (roomSelect && picked) {
            for (let i = 0; i < roomSelect.options.length; i++) {
              if (roomSelect.options[i].value.includes(picked.split(" ")[0])) {
                roomSelect.selectedIndex = i;
                break;
              }
            }
            roomSelect.focus();
          }
        });
      });

      const quickBookingForm = document.getElementById("quickBookingForm");
      if (quickBookingForm) {
        quickBookingForm.addEventListener("submit", (e) => {
          e.preventDefault();
          const isSw = html.getAttribute("data-lang") === "sw";
          const checkIn = checkInInput?.value || "";
          const checkOut = checkOutInput?.value || "";
          const room = roomSelect?.value || "Deluxe Room";
          const guests = guestsSelect?.value || "2 Guests";
          const text = isSw
            ? `Habari Kas Classic Hotel (Makambako)! Naomba kuuliza upatikanaji na bei ya chumba:\n\n• Chumba: ${room}\n• Wageni: ${guests}\n• Tarehe ya Kuingia: ${checkIn}\n• Tarehe ya Kuondoka: ${checkOut}\n\nTafadhali nijulishe upatikanaji.`
            : `Hello Kas Classic Hotel (Makambako)! I would like to check room availability and rates:\n\n• Room: ${room}\n• Guests: ${guests}\n• Check-In: ${checkIn}\n• Check-Out: ${checkOut}\n\nPlease confirm availability.`;
          window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`, "_blank", "noopener");
        });
      }

      // Initialize carousels
      function initCarousel(rootSelector, slideSelector, dotSelector, trackSelector, intervalMs) {
        const root = document.querySelector(rootSelector);
        if (!root) return;
        const track = trackSelector ? root.querySelector(trackSelector) : null;
        const slides = Array.from(root.querySelectorAll(slideSelector));
        const dots = Array.from(root.querySelectorAll(dotSelector));
        let activeSlide = 0;
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let hovered = false;
        let focused = false;
        let timer = 0;
        let touchStartX = null;

        function showSlide(index) {
          activeSlide = (index + slides.length) % slides.length;
          if (track) {
            track.style.transform = `translateX(-${activeSlide * 100}%)`;
          }
          slides.forEach((slide, slideIndex) => {
            slide.classList.toggle("is-active", slideIndex === activeSlide);
            slide.setAttribute("aria-hidden", String(slideIndex !== activeSlide));
            dots[slideIndex]?.setAttribute("aria-current", String(slideIndex === activeSlide));
          });
        }

        function restartTimer() {
          window.clearInterval(timer);
          if (!reducedMotion && !hovered && !focused && !document.hidden) {
            timer = window.setInterval(() => showSlide(activeSlide + 1), intervalMs);
          }
        }

        root.querySelector(".prev")?.addEventListener("click", () => {
          showSlide(activeSlide - 1);
          restartTimer();
        });
        root.querySelector(".next")?.addEventListener("click", () => {
          showSlide(activeSlide + 1);
          restartTimer();
        });
        dots.forEach((dot) => dot.addEventListener("click", () => {
          showSlide(Number(dot.dataset.go));
          restartTimer();
        }));
        root.addEventListener("keydown", (event) => {
          if (event.key === "ArrowLeft") {
            event.preventDefault();
            showSlide(activeSlide - 1);
            restartTimer();
          } else if (event.key === "ArrowRight") {
            event.preventDefault();
            showSlide(activeSlide + 1);
            restartTimer();
          }
        });
        root.addEventListener("pointerenter", (event) => {
          if (event.pointerType !== "mouse") return;
          hovered = true;
          restartTimer();
        });
        root.addEventListener("pointerleave", (event) => {
          if (event.pointerType !== "mouse") return;
          hovered = false;
          restartTimer();
        });
        root.addEventListener("focusin", (event) => {
          focused = event.target instanceof HTMLElement && event.target.matches(":focus-visible");
          restartTimer();
        });
        root.addEventListener("focusout", (event) => {
          focused = event.relatedTarget instanceof HTMLElement
            && root.contains(event.relatedTarget)
            && event.relatedTarget.matches(":focus-visible");
          restartTimer();
        });
        root.addEventListener("touchstart", (event) => {
          window.clearInterval(timer);
          touchStartX = event.changedTouches[0]?.clientX ?? null;
        }, { passive: true });
        root.addEventListener("touchend", (event) => {
          const endX = event.changedTouches[0]?.clientX;
          if (touchStartX !== null && endX !== undefined && Math.abs(endX - touchStartX) > 40) {
            showSlide(activeSlide + (endX < touchStartX ? 1 : -1));
          }
          touchStartX = null;
          restartTimer();
        }, { passive: true });
        root.addEventListener("touchcancel", () => {
          touchStartX = null;
          restartTimer();
        }, { passive: true });
        document.addEventListener("visibilitychange", restartTimer);
        showSlide(0);
        restartTimer();
      }

      initCarousel("[data-room-carousel]", ".stay-carousel-slide", ".stay-carousel-dot", ".stay-carousel-track", 3500);
      initCarousel("[data-hotel-carousel]", ".hotel-carousel-slide", ".hotel-carousel-dot", null, 5000);

      const eventTabs = Array.from(document.querySelectorAll("[data-event-tab]"));
      const eventPanels = Array.from(document.querySelectorAll("[data-event-panel]"));
      function selectEventTab(tab, moveFocus = false) {
        eventTabs.forEach((item) => {
          const selected = item === tab;
          item.setAttribute("aria-selected", String(selected));
          item.tabIndex = selected ? 0 : -1;
        });
        eventPanels.forEach((panel) => {
          panel.hidden = panel.dataset.eventPanel !== tab.dataset.eventTab;
        });
        if (moveFocus) tab.focus();
      }
      eventTabs.forEach((tab, index) => {
        tab.addEventListener("click", () => selectEventTab(tab));
        tab.addEventListener("keydown", (event) => {
          let nextIndex = index;
          if (event.key === "ArrowRight") nextIndex = (index + 1) % eventTabs.length;
          else if (event.key === "ArrowLeft") nextIndex = (index - 1 + eventTabs.length) % eventTabs.length;
          else if (event.key === "Home") nextIndex = 0;
          else if (event.key === "End") nextIndex = eventTabs.length - 1;
          else return;
          event.preventDefault();
          selectEventTab(eventTabs[nextIndex], true);
        });
      });

      let initialLang = "en";
      try {
        initialLang = localStorage.getItem("kas_lang") || "en";
      } catch (e) {}
      setLanguage(initialLang);
    })();
  </script>
</Layout>
