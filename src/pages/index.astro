---
import Layout from "../layouts/Layout.astro";
import {
  hotelInfo,
  roomCategories,
  inRoomAmenities,
  hotelFacilities,
  signatureDishesPreview,
} from "../data/hotelData";

const location = `${hotelInfo.city}, ${hotelInfo.region}, ${hotelInfo.country}`;
const whatsappUrl = (message: string) =>
  `https://wa.me/${hotelInfo.whatsappNumber}?text=${encodeURIComponent(message)}`;

const availabilityEn = whatsappUrl("Hello Kas Classic Hotel, please share room options, rates and availability for my dates.");
const availabilitySw = whatsappUrl("Habari Kas Classic Hotel, naomba kufahamu chaguo za vyumba, bei na upatikanaji kwa tarehe zangu.");
const contactEn = whatsappUrl("Hello Kas Classic Hotel, I would like to get in touch.");
const contactSw = whatsappUrl("Habari Kas Classic Hotel, ningependa kuwasiliana nanyi.");
const eventHostEn = whatsappUrl("Hello Kas Classic Hotel, I would like to enquire about hosting a private or poolside event.");
const eventHostSw = whatsappUrl("Habari Kas Classic Hotel, ningependa kuuliza kuhusu kuandaa tukio au sherehe hotelini.");

const roomPhotos = [
  {
    src: "/images/hotel/stay-bedroom-headboard.webp",
    alt: "Deluxe bedroom with tall upholstered headboard, vanity mirror and lounge chair at Kas Classic Hotel",
    en: "Deluxe King/Double bedroom with upholstered headboard, crystal vanity mirror and armchair.",
    sw: "Chumba cha Deluxe chenye kitanda kikubwa, kioo cha kujipamba na kiti cha kupumzikia.",
  },
  {
    src: "/images/hotel/stay-bedroom-dressing.webp",
    alt: "Bedroom with air conditioning, 43-inch TV, digital safe, wardrobe and en-suite bathroom",
    en: "Equipped with air conditioning (AC), 43\" TV, digital safe box, wardrobe and en-suite bath.",
    sw: "Kina kiyoyozi (AC), TV ya inchi 43, kasiki ya kidijitali (safe), kabati na bafu ndani.",
  },
  {
    src: "/images/hotel/stay-twin-beds.webp",
    alt: "Twin room with two beds, ambient under-bed lighting and tea trays at Kas Classic Hotel",
    en: "Classic Twin Room arranged with two beds, warm ambient LED lighting and bedside tea service.",
    sw: "Chumba cha Twin chenye vitanda viwili, mwanga tulivu wa LED na huduma ya chai chumbani.",
  },
  {
    src: "/images/hotel/stay-bedroom-storage.webp",
    alt: "Bright bedroom showing mini-fridge, flat-screen TV, storage and en-suite bathroom entrance",
    en: "Bright room layout featuring an in-room mini-fridge, flat-screen TV and private hot-water bathroom.",
    sw: "Chumba chenye mwanga, friji ndogo ndani, televisheni na bafu lenye maji ya moto.",
  },
  {
    src: "/images/hotel/stay-bedroom-tv.webp",
    alt: "Another bedroom view with bed, television and bathroom entrance at Kas Classic Hotel",
    en: "Clean, quiet and self-contained accommodation designed for restful stays in Makambako.",
    sw: "Vyumba safi na tulivu vyenye kila kitu ndani kwa mapumziko bora mjini Makambako.",
  },
];

const hotelPhotos = [
  {
    src: "/images/hotel/pool-04.jpg",
    alt: "Aerial view of the Kas Classic Hotel heated swimming pool, sunken lounge and cabanas",
    enTitle: "Hot Swimming Pool & Sunken Lounge",
    swTitle: "Bwawa la Maji ya Moto na Mapumziko",
    enDetail: "Heated outdoor pool · Sunken seating & cabanas",
    swDetail: "Bwawa la maji ya moto · Masofa na sehemu ya kupumzikia",
  },
  {
    src: "/images/hotel/pool-05.jpg",
    alt: "Evening poolside view with underwater LED lighting and sun loungers at Kas Classic Hotel",
    enTitle: "Evening Poolside Atmosphere",
    swTitle: "Mandhari ya Bwawa Wakati wa Jioni",
    enDetail: "Underwater LED lighting & poolside seating",
    swDetail: "Taa za ndani ya maji na viti vya kupumzikia",
  },
  {
    src: "/images/hotel/outside-05.jpg",
    alt: "Restaurant entrance and two-story bamboo Fruit Juice pavilion at Kas Classic Hotel",
    enTitle: "Restaurant & Fruit Juice Pavilion",
    swTitle: "Mgahawa na Banda la Ghorofa la Juisi",
    enDetail: "Main dining hall & fresh juice bar",
    swDetail: "Mgahawa mkuu na banda la juisi safi",
  },
  {
    src: "/images/hotel/outside-06.jpg",
    alt: "Kas Classic Hotel main signpost and spacious cabro-paved parking courtyard in Makambako",
    enTitle: "Main Entrance & Paved Parking Courtyard",
    swTitle: "Lango Kuu na Maegesho Makubwa ya Magari",
    enDetail: "Makambako, Njombe Region",
    swDetail: "Makambako, Mkoa wa Njombe",
  },
];
---

<Layout>
  <a class="skip-link" href="#main">
    <span data-i18n="en">Skip to content</span>
    <span data-i18n="sw">Ruka hadi maudhui</span>
  </a>

  <div class="topbar">
    <div class="shell topbar-inner">
      <p class="topbar-location">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        {location}
      </p>
      <p class="topbar-message">
        <span data-i18n="en">Direct Hotel Contacts: {hotelInfo.phoneDisplay} · {hotelInfo.secondaryPhone}</span>
        <span data-i18n="sw">Mawasiliano ya Moja kwa Moja: {hotelInfo.phoneDisplay} · {hotelInfo.secondaryPhone}</span>
      </p>
    </div>
  </div>

  <header class="site-header">
    <div class="shell header-inner">
      <a href="#home" class="brand" aria-label="Kas Classic Hotel home">
        <img class="brand-logo" src="/images/hotel/hotel-logo.png" alt="Kas Classic Hotel" />
        <span class="brand-copy">
          <span class="brand-subtitle">HOTEL · MAKAMBAKO</span>
        </span>
      </a>

      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation">
        <span></span><span></span>
      </button>

      <nav class="main-nav" id="primary-navigation" aria-label="Main navigation">
        <a href="#stay"><span data-i18n="en">Rooms &amp; Stay</span><span data-i18n="sw">Vyumba &amp; Malazi</span></a>
        <a href="#discover"><span data-i18n="en">Pool, Gym &amp; Facilities</span><span data-i18n="sw">Bwawa, Gym &amp; Huduma</span></a>
        <a href="/menu/"><span data-i18n="en">Menu</span><span data-i18n="sw">Menyu</span></a>
        <a href="#events"><span data-i18n="en">Events &amp; Packages</span><span data-i18n="sw">Matukio &amp; Vifurushi</span></a>
        <a href="#visit"><span data-i18n="en">Find us</span><span data-i18n="sw">Mahali</span></a>
        <a class="instagram-link" href={hotelInfo.instagram.profileUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.7" cy="6.8" r=".8" fill="currentColor" stroke="none" /></svg>
        </a>
        <a
          class="button button-small button-red mobile-nav-cta"
          href="#book-bar"
        >
          <span data-i18n="en">Book / Check availability</span>
          <span data-i18n="sw">Weka nafasi / Uliza</span>
          <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
        </a>
      </nav>

      <div class="header-actions">
        <div class="language-switch" role="group" aria-label="Language">
          <button type="button" data-set-lang="en" aria-pressed="true">EN</button>
          <button type="button" data-set-lang="sw" aria-pressed="false">SW</button>
        </div>
        <a
          class="button button-small button-red"
          href="#book-bar"
        >
          <span data-i18n="en">Check availability</span>
          <span data-i18n="sw">Uliza upatikanaji</span>
          <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
        </a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- 1. Hero Section with Verified Hotel Highlights -->
    <section class="hero" id="home" aria-labelledby="hero-title">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow eyebrow-light">
            <span class="eyebrow-dot"></span>
            <span data-i18n="en">Accommodation · Hot Pool · Gym · Dining in Makambako</span>
            <span data-i18n="sw">Malazi · Bwawa la Maji ya Moto · Gym · Mgahawa Makambako</span>
          </p>
          <h1 id="hero-title">
            <span data-i18n="en">Stay at <em>Kas Classic Hotel.</em></span>
            <span data-i18n="sw">Karibu <em>Kas Classic Hotel.</em></span>
          </h1>
          <p class="hero-description">
            <span data-i18n="en">Your complete hospitality destination in Makambako. Enjoy air-conditioned rooms, a Honeymoon suite, heated swimming pool, upper-level gym, restaurant, Nyama Choma, fresh juice pavilion, and on-site Mini Bank &amp; Mini Shop.</span>
            <span data-i18n="sw">Kituo chako kamili cha malazi na mapumziko mjini Makambako. Furahia vyumba vyenye AC, Honeymoon Suite, bwawa la kuogelea la maji ya moto, Gym, mgahawa, Nyama Choma, banda la juisi pamoja na Mini Bank na Mini Shop.</span>
          </p>

          <div class="hero-badges" aria-label="Key hotel features">
            <span class="hero-badge">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 15c1.7-1.5 3.3-1.5 5 0s3.3 1.5 5 0 3.3-1.5 5 0 3.3 1.5 5 0"/><path d="M2 19c1.7-1.5 3.3-1.5 5 0s3.3 1.5 5 0 3.3-1.5 5 0 3.3 1.5 5 0"/><path d="M12 3c1.5 2 2.5 3.8 2.5 5.5a2.5 2.5 0 1 1-5 0C9.5 6.8 10.5 5 12 3Z"/></svg>
              <span data-i18n="en">Hot Swimming Pool</span><span data-i18n="sw">Bwawa la Maji ya Moto</span>
            </span>
            <span class="hero-badge">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M4.9 4.9l14.2 14.2M2 12h20M4.9 19.1 19.1 4.9"/></svg>
              <span data-i18n="en">AC &amp; En-Suite Rooms</span><span data-i18n="sw">Vyumba Vyenye AC</span>
            </span>
            <span class="hero-badge">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 1 1 12 6a5 5 0 1 1 7.5 6.6Z"/></svg>
              <span data-i18n="en">Honeymoon Room</span><span data-i18n="sw">Chumba cha Honeymoon</span>
            </span>
            <span class="hero-badge">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 6.5v11M17.5 6.5v11M3 9v6M21 9v6M6.5 12h11"/></svg>
              <span data-i18n="en">Fitness Gym</span><span data-i18n="sw">Gym ya Mazoezi</span>
            </span>
            <span class="hero-badge">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 2v7c0 1.7 1.3 3 3 3v10M6 2v20M9 2v7c0 1.7-1.3 3-3 3"/><path d="M18 2v20M18 2c-2.8 0-4 2.5-4 6v4h4"/></svg>
              <span data-i18n="en">Nyama Choma &amp; Juice Bar</span><span data-i18n="sw">Nyama Choma &amp; Juisi</span>
            </span>
          </div>

          <div class="hero-actions">
            <a
              class="button button-red"
              href="#book-bar"
            >
              <span data-i18n="en">Reserve / Check Dates</span>
              <span data-i18n="sw">Weka Nafasi / Chagua Tarehe</span>
              <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </a>
            <a class="button button-ghost" href="/menu/">
              <span data-i18n="en">Explore Food &amp; Juice Menu</span>
              <span data-i18n="sw">Tazama Menyu ya Chakula</span>
            </a>
          </div>
          <p class="hero-note">
            <span data-i18n="en">Direct hotel lines: {hotelInfo.phoneDisplay} / {hotelInfo.secondaryPhone}</span>
            <span data-i18n="sw">Simu za moja kwa moja hotelini: {hotelInfo.phoneDisplay} / {hotelInfo.secondaryPhone}</span>
          </p>
        </div>
        <figure class="hero-art">
          <img
            class="hero-art-img"
            src="/images/hotel/outside-01.jpg"
            alt="Kas Classic Hotel building in Makambako showing main rooms, Honeymoon wing and rooftop gym"
            fetchpriority="high"
          />
        </figure>
      </div>
    </section>

    <!-- 2. Interactive Quick Availability & WhatsApp Booking Bar -->
    <div class="booking-bar-wrap" id="book-bar">
      <div class="shell">
        <div class="booking-bar">
          <form class="booking-bar-form" id="quickBookingForm">
            <div class="booking-field">
              <label for="bookCheckIn">
                <span data-i18n="en">Check-In Date</span>
                <span data-i18n="sw">Tarehe ya Kuingia</span>
              </label>
              <input type="date" id="bookCheckIn" required />
            </div>
            <div class="booking-field">
              <label for="bookCheckOut">
                <span data-i18n="en">Check-Out Date</span>
                <span data-i18n="sw">Tarehe ya Kuondoka</span>
              </label>
              <input type="date" id="bookCheckOut" required />
            </div>
            <div class="booking-field">
              <label for="bookRoomType">
                <span data-i18n="en">Room Category</span>
                <span data-i18n="sw">Aina ya Chumba</span>
              </label>
              <select id="bookRoomType">
                <option value="Deluxe King / Double Room" data-label-en="Deluxe King / Double Room" data-label-sw="Chumba cha Deluxe (King / Double)">Deluxe King / Double Room</option>
                <option value="Classic Twin Room (2 Beds)" data-label-en="Classic Twin Room (2 Beds)" data-label-sw="Chumba cha Twin (Vitanda 2)">Classic Twin Room (2 Beds)</option>
                <option value="Honeymoon & VIP Room" data-label-en="Honeymoon & VIP Room" data-label-sw="Chumba cha Honeymoon & VIP">Honeymoon &amp; VIP Room</option>
                <option value="Multiple Rooms / Group Booking" data-label-en="Multiple Rooms / Group" data-label-sw="Vyumba Vingi / Kikundi">Multiple Rooms / Group</option>
              </select>
            </div>
            <div class="booking-field">
              <label for="bookGuests">
                <span data-i18n="en">Guests</span>
                <span data-i18n="sw">Idadi ya Wageni</span>
              </label>
              <select id="bookGuests">
                <option value="1 Guest" data-label-en="1 Guest" data-label-sw="Mgeni 1">1 Guest</option>
                <option value="2 Guests" data-label-en="2 Guests" data-label-sw="Wageni 2" selected>2 Guests</option>
                <option value="3-4 Guests" data-label-en="3–4 Guests" data-label-sw="Wageni 3–4">3–4 Guests</option>
                <option value="5+ Group" data-label-en="5+ Guests (Group)" data-label-sw="Wageni 5+ (Kikundi)">5+ Guests (Group)</option>
              </select>
            </div>
            <button type="submit" class="button button-red booking-bar-submit">
              <span data-i18n="en">Inquire on WhatsApp</span>
              <span data-i18n="sw">Tuma Maombi WhatsApp</span>
              <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- 3. Accommodation Section: Real Room Carousel + In-Room Amenities + 3 Room Category Cards -->
    <section class="stay-section section-pad" id="stay">
      <div class="shell">
        <div class="stay-feature">
          <div class="stay-feature-image" data-room-carousel tabindex="0" role="region" aria-roledescription="carousel" aria-label="Accommodation photos" data-label-en="Accommodation photos" data-label-sw="Picha za malazi">
            <div class="stay-carousel-stage" aria-live="off">
              <div class="stay-carousel-track">
                {roomPhotos.map((photo, index) => (
                  <figure
                    class:list={["stay-carousel-slide", { "is-active": index === 0 }]}
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`${index + 1} of ${roomPhotos.length}`}
                    aria-hidden={index !== 0}
                  >
                    <img src={photo.src} alt={photo.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
                    <figcaption>
                      <span data-i18n="en">{photo.en}</span>
                      <span data-i18n="sw">{photo.sw}</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
              <button class="stay-carousel-arrow prev" type="button" aria-label="Previous room photo" data-label-en="Previous room photo" data-label-sw="Picha ya chumba iliyotangulia">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
              </button>
              <button class="stay-carousel-arrow next" type="button" aria-label="Next room photo" data-label-en="Next room photo" data-label-sw="Picha ya chumba inayofuata">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              </button>
            </div>
            <div class="stay-carousel-footer">
              <div class="stay-carousel-dots" role="group" aria-label="Choose a room photo" data-label-en="Choose a room photo" data-label-sw="Chagua picha ya chumba">
                {roomPhotos.map((_photo, index) => (
                  <button
                    class="stay-carousel-dot"
                    type="button"
                    aria-label={`Show room photo ${index + 1}`}
                    aria-current={index === 0 ? "true" : "false"}
                    data-label-en={`Show room photo ${index + 1}`}
                    data-label-sw={`Onyesha picha ya chumba ${index + 1}`}
                    data-go={index}
                  ></button>
                ))}
              </div>
            </div>
          </div>

          <div class="stay-feature-copy">
            <p class="eyebrow"><span class="eyebrow-dot"></span>
              <span data-i18n="en">Inside Our Rooms</span>
              <span data-i18n="sw">Ndani ya Vyumba Vyetu</span>
            </p>
            <h2>
              <span data-i18n="en">Modern comfort<br /><em>built in.</em></span>
              <span data-i18n="sw">Starehe ya kisasa<br /><em>ndani ya chumba.</em></span>
            </h2>
            <p>
              <span data-i18n="en">Every room at Kas Classic Hotel is thoughtfully furnished with modern conveniences—from climate control and a digital safe to a mini-fridge, electric tea kettle, and private hot shower.</span>
              <span data-i18n="sw">Kila chumba katika Kas Classic Hotel kimewekewa vifaa vya kisasa—kuanzia kiyoyozi (AC), kasiki ya kidijitali (safe), friji ndogo, birika la chai hadi bafu lenye maji ya moto.</span>
            </p>

            <ul class="amenity-pills" aria-label="In-room amenities">
              {inRoomAmenities.map((item) => (
                <li class="amenity-pill">
                  <span class="amenity-icon" aria-hidden="true">
                    {item.iconId === "ac" && (
                      <svg viewBox="0 0 24 24"><path d="M12 2v20M4.9 4.9l14.2 14.2M2 12h20M4.9 19.1 19.1 4.9"/></svg>
                    )}
                    {item.iconId === "shower" && (
                      <svg viewBox="0 0 24 24"><path d="M4 4v5a6 6 0 0 1 12 0H4ZM10 4V2M7 13v2M11 13v2M15 13v2M8 18v2M12 18v2"/></svg>
                    )}
                    {item.iconId === "tv" && (
                      <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 21h8M12 18v3"/></svg>
                    )}
                    {item.iconId === "safe" && (
                      <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M12 9V7M15 12h2M6 20v2M18 20v2"/></svg>
                    )}
                    {item.iconId === "fridge" && (
                      <svg viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M5 10h14M8 6v2M8 13v3"/></svg>
                    )}
                    {item.iconId === "kettle" && (
                      <svg viewBox="0 0 24 24"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8Z"/><path d="M6 2v3M10 2v3M14 2v3"/></svg>
                    )}
                    {item.iconId === "phone" && (
                      <svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7A2 2 0 0 1 22 16.9Z"/></svg>
                    )}
                    {item.iconId === "vanity" && (
                      <svg viewBox="0 0 24 24"><ellipse cx="12" cy="10" rx="6" ry="7"/><path d="M6 21h12M9 17v4M15 17v4M10 7l4 4"/></svg>
                    )}
                  </span>
                  <span data-i18n="en">{item.en}</span>
                  <span data-i18n="sw">{item.sw}</span>
                </li>
              ))}
            </ul>

            <a
              class="button button-red"
              href={availabilityEn}
              data-wa-en={availabilityEn}
              data-wa-sw={availabilitySw}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span data-i18n="en">Ask about room rates</span>
              <span data-i18n="sw">Uliza bei za vyumba</span>
              <svg class="icon-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </a>
          </div>
        </div>

        <!-- Room Categories Breakdown Cards -->
        <div class="room-cards-header">
          <div>
            <p class="eyebrow"><span class="eyebrow-dot"></span>
              <span data-i18n="en">Room Options</span>
              <span data-i18n="sw">Chaguo za Vyumba</span>
            </p>
            <h3>
              <span data-i18n="en">Choose your room style</span>
              <span data-i18n="sw">Chagua aina ya chumba chako</span>
            </h3>
          </div>
          <p>
            <span data-i18n="en">Select a room below to pre-fill your availability enquiry.</span>
            <span data-i18n="sw">Bofya chumba hapa chini kuomba nafasi na bei za tarehe zako.</span>
          </p>
        </div>

        <div class="room-cards-grid">
          {roomCategories.map((room) => (
            <article class="room-card">
              <div class="room-card-media">
                <img src={room.image} alt={room.nameEn} loading="lazy" decoding="async" />
                <span class="room-card-badge">
                  <span data-i18n="en">{room.badgeEn}</span>
                  <span data-i18n="sw">{room.badgeSw}</span>
                </span>
              </div>
              <div class="room-card-body">
                <h4>
                  <span data-i18n="en">{room.nameEn}</span>
                  <span data-i18n="sw">{room.nameSw}</span>
                </h4>
                <p>
                  <span data-i18n="en">{room.descEn}</span>
                  <span data-i18n="sw">{room.descSw}</span>
                </p>
                <ul class="room-card-list">
                  {room.highlightsEn.map((hEn, i) => (
                    <li>
                      <span data-i18n="en">{hEn}</span>
